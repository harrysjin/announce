# Python 서버 프로세스의 비밀 환경변수로 설정하세요. 이 파일은 자동 로드하지 않습니다.
# 실제 인증키를 저장소에 커밋하지 마세요.
STDICT_API_KEY=

# 선택 사항: PostgreSQL을 연결하지 않아도 기존 PDF 분석·수정은 작동합니다.
# 이 값은 서버에만 설정합니다. VITE_ 접두사를 붙이거나 클라이언트에 포함하지 마세요.
DATABASE_URL=
# 서로 다른 충분히 긴 난수 비밀값(각 32자 이상)을 설정하세요.
LEARNING_ADMIN_TOKEN=
LEARNING_ADMIN_ID=primary-reviewer
LEARNING_DOCUMENT_KEY=
# 자동 마이그레이션은 하지 않습니다. 환경변수 설정 후 python -m backend.learning_db 실행.
# HTTPS 리버스 프록시 뒤에서는 외부 HTTPS origin을 지정해 Secure 쿠키를 사용합니다.
# 예: https://your-service.onrender.com (마지막 / 없음)
LEARNING_PUBLIC_ORIGIN=
